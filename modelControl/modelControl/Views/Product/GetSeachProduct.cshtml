@{
}
<div>

    <h1>Get All Product</h1>
    <table class="table-bordered">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>YearRelease</th>
            <th>Price</th>
        </tr>

        @foreach (var item in ViewBag.Product)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.YearRelease</td>
                <td>@item.Price</td>
            </tr>
        }

    </table>
</div>