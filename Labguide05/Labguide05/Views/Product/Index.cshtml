@model IEnumerable<Labguide05.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách sản phẩm</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm mới sản phẩm</a>
</div>

<table class="table table-bordered table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Giá bán</th>
            <th>Giá KM</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int stt = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td>@(stt++)</td>
                    <td class="text-center">
                        <img src="@item.Image" alt="@item.Name" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border" />
                    </td>
                    <td>
                        <strong>@item.Name</strong>
                    </td>
                    <td class="text-primary fw-bold">
                        @item.Price.ToString("N0") VNĐ
                    </td>
                    <td class="text-danger fw-bold">
                        @item.SalePrice.ToString("N0") VNĐ
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Chưa có sản phẩm nào. Hãy bấm "Thêm mới sản phẩm" để khởi tạo.</td>
            </tr>
        }
    </tbody>
</table>