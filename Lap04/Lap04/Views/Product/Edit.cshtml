@model Lap04.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<h1>Sửa sản phẩm</h1>
<h4>Product</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 form-group">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" type="number" min="0" step="1000" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="SalePrice" class="control-label"></label>
                    <input asp-for="SalePrice" type="number" min="0" step="1000" class="form-control" />
                    <span asp-validation-for="SalePrice" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label d-block"></label>
                <div class="form-check form-check-inline">
                    <input asp-for="Status" id="statusActive" class="form-check-input" type="radio" value="1" />
                    <label class="form-check-label" for="statusActive">Đang bán</label>
                </div>
                <div class="form-check form-check-inline">
                    <input asp-for="Status" id="statusInactive" class="form-check-input" type="radio" value="0" />
                    <label class="form-check-label" for="statusInactive">Ngừng bán</label>
                </div>
                <span asp-validation-for="Status" class="text-danger d-block"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CreatedDate" class="control-label"></label>
                <input asp-for="CreatedDate" type="date" class="form-control" />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Hình ảnh hiện tại</label>
                <div class="mb-2">
                    @{
                        var imgSrc = !string.IsNullOrEmpty(Model.Image) ? Model.Image : "/images/products/default.png";
                    }
                    <img id="currentImg" src="@Url.Content(imgSrc)" alt="Image"
                         style="width:100px;height:100px;object-fit:cover;border-radius:8px;border:1px solid #dee2e6;" />
                </div>
                <input type="hidden" asp-for="Image" />
                <label class="control-label">Thay ảnh mới (tùy chọn)</label>
                <input type="file" name="ImageFile" id="ImageFile" class="form-control"
                       accept="image/*" onchange="previewImage(event)" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function previewImage(event) {
            var input = event.target;
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('currentImg').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
