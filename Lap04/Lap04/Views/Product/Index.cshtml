@model IEnumerable<Lap04.Models.Product>
@using Lap04.Models

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Danh sách sản phẩm</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm sản phẩm
    </a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Hình ảnh</th>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Price)</th>
            <th>@Html.DisplayNameFor(m => m.SalePrice)</th>
            <th>@Html.DisplayNameFor(m => m.CategoryId)</th>
            <th>@Html.DisplayNameFor(m => m.Status)</th>
            <th>@Html.DisplayNameFor(m => m.CreatedDate)</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var category = DataLocal.GetCategoryById(item.CategoryId);
            <tr>
                <td>@item.Id</td>
                <td>
                    @{
                        var imgSrc = !string.IsNullOrEmpty(item.Image) ? item.Image : "/images/products/default.png";
                    }
                    <img src="@Url.Content(imgSrc)"
                         alt="@item.Name"
                         style="width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #dee2e6;" />
                </td>
                <td><strong>@item.Name</strong></td>
                <td>@item.Price.ToString("N0") ₫</td>
                <td class="text-danger fw-bold">@item.SalePrice.ToString("N0") ₫</td>
                <td>@(category?.Name ?? "—")</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="badge bg-success">Đang bán</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng bán</span>
                    }
                </td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-primary me-1" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info me-1" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>
