@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Quản lý Danh mục</h2>
    <button type="button" class="btn btn-primary" onclick="alert('Chức năng thêm mới đang được phát triển')">
        + Thêm danh mục mới
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Danh sách danh mục sản phẩm</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#ID</th>
                        <th>Tên danh mục</th>
                        <th>Trạng thái</th>
                        <th style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Điện thoại & Thiết bị di động</td>
                        <td><span class="badge bg-success">Hiển thị</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning me-1">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Máy tính bảng & Laptop</td>
                        <td><span class="badge bg-success">Hiển thị</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning me-1">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Phụ kiện công nghệ</td>
                        <td><span class="badge bg-secondary">Tạm ẩn</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning me-1">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>