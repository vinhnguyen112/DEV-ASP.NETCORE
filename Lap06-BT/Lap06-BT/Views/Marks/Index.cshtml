@model IEnumerable<Marks>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Subject)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Score)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Subject.SubjectName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Student.StudentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Score)
            </td>
            <td>
                <a asp-action="Edit" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Edit</a> |
                <a asp-action="Details" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Details</a> |
                <a asp-action="Delete" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
