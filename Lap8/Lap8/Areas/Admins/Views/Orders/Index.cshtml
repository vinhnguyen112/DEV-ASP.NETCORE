@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Lesson08.Lab.Models.Orders>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Quản lý đơn hàng</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Thêm mới đơn hàng
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-white py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-auto">
                    <input type="text" name="name" value="@ViewBag.keyword" class="form-control form-control-sm" placeholder="Tìm theo tên người nhận..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-secondary">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.keyword))
                    {
                        <a asp-action="Index" class="btn btn-sm btn-light border ms-1">Bỏ lọc</a>
                    }
                </div>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 70px;">Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th>Người nhận</th>
                            <th>Email</th>
                            <th>Địa chỉ giao hàng</th>
                            <th class="text-center" style="width: 140px;">Trạng thái</th>
                            <th style="width: 150px;">Ngày đặt</th>
                            <th class="text-center" style="width: 190px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Chưa có đơn hàng nào. Hãy bấm "Thêm mới đơn hàng".
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center font-monospace fw-bold">#@item.Id</td>
                                    <td>@(item.Customer?.FullName ?? $"KH #{item.CustomerId}")</td>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td>@item.Email</td>
                                    <td class="small text-muted">@item.Address</td>
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case 0:
                                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                break;
                                            case 1:
                                                <span class="badge bg-info text-dark">Đang giao</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-success">Đã hoàn thành</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Mới</span>
                                                break;
                                        }
                                    </td>
                                    <td class="small">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Chi tiết</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <div class="text-muted small">
                Hiển thị trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount (Tổng số: @Model.TotalItemCount đơn hàng)
            </div>
            <div>
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page, name = ViewBag.keyword }), new X.PagedList.Web.Common.PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },
                    UlElementClasses = new[] { "pagination", "pagination-sm", "mb-0" }
                })
            </div>
        </div>
    </div>
</div>
