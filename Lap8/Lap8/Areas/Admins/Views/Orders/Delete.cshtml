@model Lesson08.Lab.Models.Orders

@{
    ViewData["Title"] = "Xác nhận xóa đơn hàng";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-danger">Xác nhận xóa đơn hàng</h4>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
    </div>

    <div class="card">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Bạn có chắc chắn muốn xóa đơn hàng này?</h5>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Mã đơn hàng:</dt>
                <dd class="col-sm-9 font-monospace fw-bold">#@Model.Id</dd>

                <dt class="col-sm-3 text-muted">Khách hàng:</dt>
                <dd class="col-sm-9">@(Model.Customer?.FullName ?? $"KH #{Model.CustomerId}")</dd>

                <dt class="col-sm-3 text-muted">Người nhận:</dt>
                <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                <dt class="col-sm-3 text-muted">Email:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3 text-muted">Địa chỉ giao hàng:</dt>
                <dd class="col-sm-9">@Model.Address</dd>

                <dt class="col-sm-3 text-muted">Ngày đặt:</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3 text-muted">Trạng thái:</dt>
                <dd class="col-sm-9">
                    @switch (Model.Status)
                    {
                        case 0:
                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                            break;
                        case 1:
                            <span class="badge bg-info text-dark">Đang giao</span>
                            break;
                        case 2:
                            <span class="badge bg-success">Đã hoàn thành</span>
                            break;
                        case 3:
                            <span class="badge bg-danger">Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary">Mới</span>
                            break;
                    }
                </dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Xác nhận xóa vĩnh viễn</button>
                <a asp-action="Index" class="btn btn-light border ms-2">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>
