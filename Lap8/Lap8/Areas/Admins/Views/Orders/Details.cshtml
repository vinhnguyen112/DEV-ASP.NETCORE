@model Lesson08.Lab.Models.Orders

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var details = ViewBag.OrderDetails as List<Lesson08.Lab.Models.OrderDetail> ?? new List<Lesson08.Lab.Models.OrderDetail>();
    float totalAmount = details.Sum(d => d.Quantity * d.Price);
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Chi tiết đơn hàng #@Model.Id</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm me-1">Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Thông tin giao hàng</h5>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Mã đơn hàng:</dt>
                <dd class="col-sm-9 font-monospace fw-bold">#@Model.Id</dd>

                <dt class="col-sm-3 text-muted">Tài khoản khách hàng:</dt>
                <dd class="col-sm-9">@(Model.Customer?.FullName ?? $"KH #{Model.CustomerId}")</dd>

                <dt class="col-sm-3 text-muted">Họ tên người nhận:</dt>
                <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                <dt class="col-sm-3 text-muted">Email liên hệ:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3 text-muted">Địa chỉ nhận hàng:</dt>
                <dd class="col-sm-9">@Model.Address</dd>

                <dt class="col-sm-3 text-muted">Ngày đặt hàng:</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3 text-muted">Trạng thái:</dt>
                <dd class="col-sm-9">
                    @switch (Model.Status)
                    {
                        case 0:
                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                            break;
                        case 1:
                            <span class="badge bg-info text-dark">Đang giao</span>
                            break;
                        case 2:
                            <span class="badge bg-success">Đã hoàn thành</span>
                            break;
                        case 3:
                            <span class="badge bg-danger">Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary">Mới</span>
                            break;
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Danh sách sản phẩm trong đơn hàng</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 60px;">STT</th>
                            <th>Tên sản phẩm</th>
                            <th class="text-center" style="width: 100px;">Số lượng</th>
                            <th class="text-end" style="width: 140px;">Đơn giá</th>
                            <th class="text-end" style="width: 150px;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!details.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Không có chi tiết sản phẩm nào trong đơn hàng này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            @foreach (var item in details)
                            {
                                <tr>
                                    <td class="text-center">@(index++)</td>
                                    <td class="fw-semibold">@(item.Product?.Name ?? $"Sản phẩm #{item.ProductId}")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-success">@((item.Quantity * item.Price).ToString("N0")) đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (details.Any())
                    {
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="4" class="text-end">Tổng cộng:</th>
                                <th class="text-end text-danger fs-6">@totalAmount.ToString("N0") đ</th>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>
