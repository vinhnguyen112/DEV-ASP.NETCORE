@model Lesson08.Lab.Models.Account

@{
    ViewData["Title"] = "Xác nhận xóa tài khoản";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-danger">Xác nhận xóa tài khoản</h4>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
    </div>

    <div class="card">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Bạn có chắc chắn muốn xóa tài khoản này?</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="@Model.Avatar" alt="@Model.Name" class="rounded-circle border" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-secondary" style="width: 100px; height: 100px; font-size: 2rem;">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Mã tài khoản:</dt>
                        <dd class="col-sm-9 font-monospace">@Model.Id</dd>

                        <dt class="col-sm-3 text-muted">Họ và tên:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-3 text-muted">Địa chỉ email:</dt>
                        <dd class="col-sm-9">@Model.Email</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Xác nhận xóa vĩnh viễn</button>
                <a asp-action="Index" class="btn btn-light border ms-2">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>
