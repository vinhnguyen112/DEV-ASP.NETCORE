@model Lesson08.Lab.Models.Blog

@{
    ViewData["Title"] = "Xác nhận xóa bài viết";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-danger">Xác nhận xóa bài viết</h4>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
    </div>

    <div class="card">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Bạn có chắc chắn muốn xóa bài viết này?</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.Name" class="img-thumbnail" style="max-width: 150px; max-height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="border rounded p-4 text-muted bg-light">Không có hình ảnh</div>
                    }
                </div>
                <div class="col-md-9">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Mã bài viết:</dt>
                        <dd class="col-sm-9 font-monospace">@Model.Id</dd>

                        <dt class="col-sm-3 text-muted">Tiêu đề:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-3 text-muted">Lượt xem:</dt>
                        <dd class="col-sm-9">@Model.ViewCount.ToString("N0")</dd>

                        <dt class="col-sm-3 text-muted">Nội dung:</dt>
                        <dd class="col-sm-9">@(Model.Description ?? "Không có nội dung")</dd>

                        <dt class="col-sm-3 text-muted">Trạng thái:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Status == 1)
                            {
                                <span class="badge bg-success">Công khai</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Nháp</span>
                            }
                        </dd>

                        <dt class="col-sm-3 text-muted">Ngày tạo:</dt>
                        <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Xác nhận xóa vĩnh viễn</button>
                <a asp-action="Index" class="btn btn-light border ms-2">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>
