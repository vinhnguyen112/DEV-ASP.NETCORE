@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Lesson08.Lab.Models.Customer>

@{
    ViewData["Title"] = "Danh sách khách hàng";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Quản lý khách hàng</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Thêm mới khách hàng
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-white py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-auto">
                    <input type="text" name="name" value="@ViewBag.keyword" class="form-control form-control-sm" placeholder="Tìm theo tên khách hàng..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-secondary">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.keyword))
                    {
                        <a asp-action="Index" class="btn btn-sm btn-light border ms-1">Bỏ lọc</a>
                    }
                </div>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 60px;">Mã</th>
                            <th class="text-center" style="width: 80px;">Ảnh</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Địa chỉ</th>
                            <th class="text-center" style="width: 90px;">Giới tính</th>
                            <th class="text-center" style="width: 190px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Chưa có khách hàng nào. Hãy bấm "Thêm mới khách hàng".
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center font-monospace">@item.Id</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.Avatar))
                                        {
                                            <img src="@item.Avatar" alt="@item.FullName" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-secondary" style="width: 40px; height: 40px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-semibold">@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td class="small text-muted">@item.Address</td>
                                    <td class="text-center">@(item.Gender ?? "Khác")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Chi tiết</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <div class="text-muted small">
                Hiển thị trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount (Tổng số: @Model.TotalItemCount khách hàng)
            </div>
            <div>
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page, name = ViewBag.keyword }), new X.PagedList.Web.Common.PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },
                    UlElementClasses = new[] { "pagination", "pagination-sm", "mb-0" }
                })
            </div>
        </div>
    </div>
</div>
