@model Lesson08.Lab.Models.Customer

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Chi tiết khách hàng</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm me-1">Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0">Thông tin chi tiết: @Model.FullName</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="@Model.Avatar" alt="@Model.FullName" class="rounded-circle border" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center text-secondary" style="width: 100px; height: 100px; font-size: 2rem;">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Mã khách hàng:</dt>
                        <dd class="col-sm-9 font-monospace">@Model.Id</dd>

                        <dt class="col-sm-3 text-muted">Họ và tên:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.FullName</dd>

                        <dt class="col-sm-3 text-muted">Email:</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3 text-muted">Số điện thoại:</dt>
                        <dd class="col-sm-9">@Model.Phone</dd>

                        <dt class="col-sm-3 text-muted">Địa chỉ:</dt>
                        <dd class="col-sm-9">@Model.Address</dd>

                        <dt class="col-sm-3 text-muted">Ngày sinh:</dt>
                        <dd class="col-sm-9">@Model.Birthday.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3 text-muted">Giới tính:</dt>
                        <dd class="col-sm-9">@(Model.Gender ?? "Khác")</dd>

                        <dt class="col-sm-3 text-muted">Facebook:</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.Facebook))
                            {
                                <a href="@Model.Facebook" target="_blank" rel="noopener noreferrer">@Model.Facebook</a>
                            }
                            else
                            {
                                <span class="text-muted">Chưa cập nhật</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
