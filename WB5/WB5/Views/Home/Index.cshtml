@model List<WB5.Models.Product>

@{
    ViewData["Title"] = "- Trang chủ";
}

<div class="container my-4">
    <div class="row g-4">
        <div class="col-md-3">
            <partial name="_CategoryPartial" model="ViewBag.Categories" />

            <div class="card mt-3 shadow-sm border-0 text-white text-center p-3 rounded-4" style="background: linear-gradient(135deg, #5b7065 0%, #3f5247 100%);">
                <h6 class="fw-bold mb-1" style="letter-spacing: 0.5px;">ĐỔI CŨ LẤY MỚI</h6>
                <p class="small mb-3 text-white-50">LÊN ĐỜI NỒI CHIÊN FASTER</p>
                <div class="bg-white text-dark rounded-3 p-2 mb-3 fw-bold small shadow-sm" style="color: #3f5247 !important;">
                    Chỉ 2.850.000đ
                </div>
                <button class="btn btn-sm fw-bold text-dark rounded-pill py-2 shadow-sm" style="background-color: #d8e2dc; border: none;">ĐỔI NGAY</button>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-sm mb-4 border-0 rounded-4 overflow-hidden">
                <div class="card-header text-white fw-bold py-3 px-4 border-0" style="background-color: #6b818c;">
                    <i class="bi bi-stars me-2"></i> Sản phẩm mới nhất
                </div>
                <div class="card-body p-4" style="background-color: #fcfbf9;">
                    <div class="row g-3">
                        @foreach (var item in Model)
                        {
                            <div class="col-md-4 mb-2">
                                <div class="card h-100 shadow-sm position-relative border-0 rounded-3 bg-white">
                                    <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill text-white small px-2 py-1 shadow-sm" style="background-color: #8da9c4; z-index: 2; font-size: 0.7rem;">
                                        Load từ View Action
                                    </span>
                                    <div class="p-3 text-center">
                                        <img src="@item.ImageUrl" class="card-img-top mt-2" style="height: 130px; object-fit: contain;" alt="@item.Name" />
                                    </div>
                                    <div class="card-body text-center p-3 pt-0">
                                        <p class="small fw-semibold text-secondary mb-0">@item.Name</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header text-white fw-bold py-3 px-4 border-0" style="background-color: #849974;">
                    <i class="bi bi-bookmark-heart me-2"></i> Khối sản phẩm đặc biệt
                </div>
                <div class="card-body p-4" style="background-color: #fcfbf9;">
                    @await Component.InvokeAsync("ProductList")
                </div>
            </div>
        </div>
    </div>
</div>