@{
    ViewData["Title"] = "Chi tiết " + ViewBag.Acc.Name;
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Acc")" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết sản phẩm</li>
        </ol>
    </nav>

    <div class="row bg-white p-4 rounded shadow-sm border">
        <div class="col-md-5 mb-4 mb-md-0">
            <div class="border rounded p-2 text-center">
                <img src="@Url.Content(ViewBag.Acc.img)"
                     class="img-fluid rounded"
                     style="max-height: 400px; object-fit: cover;"
                     alt="@ViewBag.Acc.Name">
            </div>
        </div>

        <div class="col-md-7">
            <h2 class="fw-bold mb-3">@ViewBag.Acc.Name</h2>

            <div class="mb-3">
                <span class="text-danger fw-bold fs-4">Giá: @ViewBag.Acc.Price đ</span>
            </div>

            <p class="text-muted mb-4">
                Thông tin mô tả chi tiết cho sản phẩm @ViewBag.Acc.Name. Tài khoản chất lượng cao, bảo hành uy tín, hỗ trợ nhanh chóng sau khi mua hàng.
            </p>

            <hr class="my-4">

            <div>
                <div class="row align-items-center mb-4">
                    <label for="quantity" class="col-sm-3 col-form-label fw-bold">Số lượng:</label>
                    <div class="col-sm-4">
                        <input type="number" id="quantity" class="form-control text-center" value="1" min="1">
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-success btn-lg px-4 flex-grow-1">Thêm vào giỏ hàng</button>
                    <a href="@Url.Action("Index", "Acc")" class="btn btn-outline-secondary btn-lg px-4">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>