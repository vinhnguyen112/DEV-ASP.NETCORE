@model IEnumerable<WB1.Models.Acc>

@{
    ViewData["Title"] = "Danh sách tài khoản";
}
<div class="container-fluid px-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold mb-3">DANH MỤC</h5>
            <div class="list-group shadow-sm">
                <a href="#" class="list-group-item list-group-item-action active bg-white text-dark border">Quần Áo</a>
                <a href="#" class="list-group-item list-group-item-action">Túi xách</a>
                <a href="#" class="list-group-item list-group-item-action">Đồng hồ</a>
                <a href="#" class="list-group-item list-group-item-action">Tivi</a>
                <a href="#" class="list-group-item list-group-item-action">Tủ lạnh</a>
                <a href="#" class="list-group-item list-group-item-action">Máy bơm</a>
                <a href="#" class="list-group-item list-group-item-action">Quạt điện</a>
                <a href="#" class="list-group-item list-group-item-action">Lò sưởi</a>
            </div>
        </div>

        <div class="col-md-9">
            <h3 class="mb-4">Danh sách sản phẩm</h3>
            <div class="row row-cols-1 row-cols-md-3 g-4">

                @foreach (var item in Model)
                  {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <img src="@Url.Content(item.img)" class="card-img-top p-2" style="height: 220px; object-fit: cover;" alt="@item.Name">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fs-6">@item.Name</h5>
                                <p class="card-text mb-2">
                                    <span class="text-danger fw-bold">Giá: @item.Price đ</span>
                                </p>
                                <a href="@Url.Action("Details", "Acc", new { name = item.Name })" class="btn btn-success mt-auto w-100">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>