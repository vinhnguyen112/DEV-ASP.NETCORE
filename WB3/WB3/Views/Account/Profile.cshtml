@{
    ViewData["Title"] = "Profile";
    var account = ViewBag.Account;
}

<h2>Your Profile</h2>
<div class="row">
    <div class="col-md-4">
        <img src="@account.img" alt="" style="width:100%" />
    </div>
    <div class="col-md-8">
        <h2>Full Name: @account.name</h2>
        <h1>@account.id</h1>
        <h1>@account.price</h1>
        <p>@account.description</p>
        <p>
            <a asp-controller="Account" asp-action="Index" class="btn btn-sm btn-danger">Back to list</a>
        </p>
    </div>
</div>