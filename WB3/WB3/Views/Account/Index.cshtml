@{
    ViewData["Title"] = "Index";
    var accounts = ViewBag.Accounts;
}
<div class="row">
    @foreach (var i in accounts)
    {
        <div class="col-md-4">
            <div class="thumbnail">
                <img src="@i.img" alt="">
                <div class="caption">
                    <h3>@i.name</h3>
                    <p>
                       @i.price
                    </p>
                    <p>
                        <a asp-route="profile" asp-route-id="@i.id" class="btn btn-success btn-block">Profile</a>
                    </p>
                </div>
            </div>
        </div>
    }

</div>
